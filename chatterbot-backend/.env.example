# Twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/chatterbot

# Redis (for Celery + caching)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
ADMIN_API_KEY=generate-a-32-character-minimum-admin-api-key

# Flask
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-flask-secret-key

# Crisis Escalation
CRISIS_ESCALATION_EMAIL=parent@example.com
CRISIS_ESCALATION_PHONE=+1234567890

# App
APP_NAME=Chatterbot
APP_URL=https://api.chatterbot.app

# Privacy and controlled pilot
PRIVACY_POLICY_VERSION=privacy-2026-09-05-draft
MESSAGE_RETENTION_DAYS=90
DELETION_GRACE_DAYS=7
PILOT_MODE=true
PILOT_FAMILY_CAPACITY=50
